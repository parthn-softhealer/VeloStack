{
  "manifest_version": 3,
  "name": "Trending Products Finder (Amazon & Flipkart)",
  "version": "2.0",
  "description": "Find trending products across ALL categories on Amazon & Flipkart with auto-refresh.",
  "permissions": [
    "activeTab",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.amazon.in/*",
    "https://www.flipkart.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Trending Products",
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
